<UserControl x:Class="ZwcadBatchPlot.AboutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="11">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="16,12,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="Teplov Print" FontWeight="Bold"
                       Foreground="#FF1A73E8" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding VersionText}"
                       Foreground="DimGray" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="#FFE0E0E0" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2" Margin="8,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Разработка текущей версии:" Foreground="DimGray" Width="180"/>
                <TextBlock Text="Вячеслав Теплов"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="На основе open-source проекта:" Foreground="DimGray" Width="180"/>
                <TextBlock Text="batchPrintZWCAD"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Автор исходного проекта:" Foreground="DimGray" Width="180"/>
                <TextBlock Text="Edwardhehe"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Версия исходного проекта:" Foreground="DimGray" Width="180"/>
                <TextBlock Text="batchPrintZWCAD 1.15.7.7"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Лицензия:" Foreground="DimGray" Width="180"/>
                <TextBlock Text="MIT"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="3" Height="1" Background="#FFE0E0E0" Margin="0,8,0,10"/>

        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Content="ОК" MinWidth="76"
                    Style="{StaticResource PluginButtonStyle}"
                    Click="OnOkClick" IsDefault="True"/>
        </StackPanel>
    </Grid>
</UserControl>
