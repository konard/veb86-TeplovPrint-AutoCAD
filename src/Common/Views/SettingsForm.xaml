<Window x:Class="ZwcadBatchPlot.SettingsForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="Настройки пакетной печати"
        Width="760" Height="600"
        MinWidth="680" MinHeight="540"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <TabControl x:Name="_tabs" Grid.Row="0" SelectionChanged="OnTabsSelectionChanged">

            
        <TabItem Header="Основные">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,10,10,0">
                    <StackPanel>

            <GroupBox Header="Сопоставление форматов" Margin="0,0,0,4" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="30" />
                                </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Допуск формата (мм)" VerticalAlignment="Center" />
                                <local:NumberBox x:Name="_paperTolerance" Grid.Row="0" Grid.Column="1"
                                                 Min="0.5" Max="20" Increment="0.5" Decimals="1"
                                                 Width="130" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Допуск длинной стороны (мм)" VerticalAlignment="Center" />
                                <local:NumberBox x:Name="_longPaperSnapTolerance" Grid.Row="1" Grid.Column="1"
                                                 Min="0.5" Max="20" Increment="0.5" Decimals="1"
                                                 Width="130" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                 ToolTip="Допуск привязки длинной стороны удлинённого формата к ближайшему стандартному шагу 1/8; влияет на бумагу и имя файла." />
                            </Grid>
                        </GroupBox>

            <GroupBox Header="Распознавание прямоугольных рамок" Margin="0,0,0,4" Padding="8">
                            <CheckBox x:Name="_recognizeFourLineRectangleFrames"
                Content="Распознавать прямоугольники из четырёх соединённых линий или полилиний"
                                      ToolTip="Четыре отдельные линии считаются соединёнными при допуске концов 0,1% длины стороны; после проверки геометрии используются как обычная полилиния-рамка." />
                        </GroupBox>

            <GroupBox Header="Параметры печати" Margin="0,0,0,4" Padding="8">
                            <StackPanel>
                <CheckBox x:Name="_openExternalDwgForPlot" Content="Временно открывать DWG при печати из файлов" Margin="0,0,0,2" />
                <CheckBox x:Name="_hideFrameBoundaryWhenPlotting" Content="Не печатать внешнюю границу рамки" Margin="0,0,0,2"
                                          ToolTip="При печати обрезает содержимое на 1 мм с каждой стороны, исключая внешнюю линию рамки; бумага, масштаб и поля не меняются." />
                <CheckBox x:Name="_plotTransparency" Content="Печатать прозрачность" Margin="0,0,0,2"
                                          ToolTip="Печатать с учётом прозрачности объектов; соответствует параметру «Печатать прозрачность» в CAD. По умолчанию включено." />
                <CheckBox x:Name="_plotObjectLineweights" Content="Печатать веса линий" Margin="0,0,0,2"
                                          ToolTip="Печатать с учётом весов линий объектов; соответствует параметру «Печатать веса линий» в CAD. По умолчанию выключено." />
                <CheckBox x:Name="_generatePrintLog" Content="Создавать журнал печати" Margin="0,0,0,2" />
                                <CheckBox x:Name="_convertTextToGeometryWhenPlotting" Content="Преобразовывать текст в графику при печати"
                                          ToolTip="Преобразовывать TrueType-текст в геометрические контуры при выводе PDF/DWF/PNG/JPG, чтобы не зависеть от наличия шрифтов. Исходный DWG не изменяется." />
                            </StackPanel>
                        </GroupBox>

            <GroupBox Header="Вывод PNG/JPG" Margin="0,0,0,4" Padding="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Разрешение (DPI)" VerticalAlignment="Center"
                                           ToolTip="Только для PNG/JPG: плотность пикселей при преобразовании временного PDF в изображение. На векторный PDF не влияет." />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <local:NumberBox x:Name="_rasterExportDpi"
                                                     Min="72" Max="600" Increment="10" Decimals="0"
                                                     Width="130" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                     ToolTip="По умолчанию 150. Чем больше значение, тем выше качество и размер файла. Допустимый диапазон: 72–600." />
                                    <TextBlock Text="По умолчанию: 150; диапазон: 72–600" Foreground="DimGray"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

            <GroupBox Header="Выходные файлы" Margin="0,0,0,4" Padding="8">
                <CheckBox x:Name="_addSequenceWhenPdfExists" Content="Добавлять номер, если PDF уже существует" />
                        </GroupBox>

            <GroupBox Header="Объединение PDF" Margin="0,0,0,4" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="_useFileNameAsPdfBookmark" Content="Использовать имя файла как закладку" Margin="0,0,0,2" />
                                <CheckBox x:Name="_useSheetTitleAsPdfBookmark" Content="Использовать наименование листа как закладку" Margin="0,0,0,2" />
                                <CheckBox x:Name="_mergePdfByPaperSize" Content="Объединять по размеру листа" Margin="0,0,0,2" />
                                <CheckBox x:Name="_keepIndividualPdfsWhenMerging" Content="Сохранять отдельные PDF при объединении" Margin="0,0,0,2" />
                                <TextBlock Foreground="DimGray"
                                           Text="Листы одного размера объединяются в один PDF. Если размеры различаются, для каждого размера создаётся отдельный PDF." />
                            </StackPanel>
                        </GroupBox>

            <GroupBox Header="Действия после завершения" Margin="0,0,0,4" Padding="8">
                            <StackPanel>
                                <CheckBox x:Name="_openOutputDirectoryAfterBatchPrint" Content="Открывать папку вывода после пакетной печати (PNG/JPG/DWF/DWG/PDF; кроме объединённых PDF)" Margin="0,0,0,2" />
                                <CheckBox x:Name="_openMergedPdfAfterMerge" Content="Открывать PDF после объединения" />
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            
        <TabItem Header="Имена файлов">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F7FCF7" BorderBrush="Gray" BorderThickness="1" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Foreground="#239137" Text="Используйте следующие буквы в правиле имени файла:" />
                            <Grid Grid.Row="1" Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#239137" Text="A: № листа" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Foreground="#239137" Text="B: редакция" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Foreground="#239137" Text="C: наименование" />
                        <TextBlock Grid.Row="0" Grid.Column="3" Foreground="#239137" Text="D: дата" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Foreground="#239137" Text="E: сведения 1" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#239137" Text="F: сведения 2" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Foreground="#239137" Text="G: стадия" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Foreground="#239137" Text="T: формат" />
                            </Grid>
                        <TextBlock Grid.Row="2" Foreground="#239137" Text="N: порядковый номер (соответствует порядку печати)" />
                        <TextBlock Grid.Row="3" Foreground="#239137" Text="Чтобы вставить саму букву, экранируйте её: например, \\A выводит A." Margin="0,4,0,0" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Правило имени:" VerticalAlignment="Center" />
                        <TextBox x:Name="_fileNamePattern" Grid.Row="0" Grid.Column="1"
                                 MaxLength="240" VerticalContentAlignment="Center"
                                 TextChanged="OnPatternTextChanged" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Начальный номер:" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <local:NumberBox x:Name="_fileNameSequenceStart"
                                             Min="0" Max="999999999" Increment="1" Decimals="0"
                                             Width="105" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                    <TextBlock Text="например, с 100" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Разрядов:" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <local:NumberBox x:Name="_fileNameSequenceDigits"
                                             Min="0" Max="10" Increment="1" Decimals="0"
                                             Width="70" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                    <TextBlock Text="0 — без ведущих нулей" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <CheckBox x:Name="_autoFileNameSequenceDigits" Content="Определять по общему числу листов"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      Checked="OnAutoDigitsChanged" Unchecked="OnAutoDigitsChanged" />
                        </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Пример:" Foreground="Navy" VerticalAlignment="Top" Margin="0,4,0,0" />
                        <TextBlock x:Name="_fileNamePreview" Grid.Row="3" Grid.Column="1" Foreground="Navy"
                                   VerticalAlignment="Top" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <GroupBox Grid.Row="2" Header="Имена удлинённых форматов" Margin="0,6,0,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Формат имени:" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="_longPaperNameFormat" Width="240" VerticalAlignment="Center"
                                      SelectionChanged="OnLongPaperFormatChanged" />
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            
        <TabItem Header="Ведомость листов">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Шрифт и оформление ведомости" Padding="6" Margin="0,0,0,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,4,0">
                            <TextBlock Text="Индекс цвета" />
                                <ComboBox x:Name="_directoryColorIndex" Margin="0,2,4,0" MaxDropDownHeight="282" />
                            <Button x:Name="_pickTextAppearanceButton" Content="Выбрать текст" MinWidth="108"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Style="{StaticResource PluginButtonStyle}"
                                        ToolTip="Выберите текст в активном чертеже, чтобы считать цвет, высоту, коэффициент ширины, стиль текста и слой."
                                        Click="OnPickTextAppearanceClick" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,4,0">
                            <TextBlock Text="Высота текста" />
                                <local:NumberBox x:Name="_directoryTextHeight"
                                                 Min="1" Max="1000000" Increment="10" Decimals="2"
                                                 HorizontalAlignment="Stretch" Margin="0,2,4,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,4,0">
                            <TextBlock Text="Коэффициент ширины" />
                                <local:NumberBox x:Name="_directoryTextWidthFactor"
                                                 Min="0.1" Max="10" Increment="0.05" Decimals="2"
                                                 HorizontalAlignment="Stretch" Margin="0,2,4,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="3" Grid.Row="0" Margin="0,0,4,0">
                            <TextBlock Text="Стиль текста" />
                                <ComboBox x:Name="_directoryTextStyle" Margin="0,2,4,0"
                                          SelectionChanged="OnTextStyleChanged" />
                            </StackPanel>

                            <StackPanel Grid.Column="4" Grid.Row="0" Margin="0,0,4,0">
                            <TextBlock Text="Имя слоя" />
                                <TextBox x:Name="_directoryLayerName" Margin="0,2,4,0" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="5" Grid.Row="0">
                            <TextBlock Text="Высота строки" />
                                <local:NumberBox x:Name="_directoryRowHeight"
                                                 Min="1" Max="1000000" Increment="10" Decimals="2"
                                                 HorizontalAlignment="Stretch" Margin="0,2,4,0" />
                                <Button x:Name="_pickRowHeightButton" Content="Выбрать в чертеже" MinWidth="68"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Style="{StaticResource PluginButtonStyle}"
                                        Click="OnPickRowHeightClick" />
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="_directoryDrawHeader" Content="Рисовать заголовок ведомости" Margin="0,0,16,0" />
                                <CheckBox x:Name="_directoryDrawGridLines" Content="Рисовать границы таблицы" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="Настройка содержимого ведомости" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="19" />
                                <RowDefinition Height="76" />
                            </Grid.RowDefinitions>

                            <DataGrid x:Name="_directoryColumnsGrid" Grid.Row="0"
                                      Style="{StaticResource PluginGridStyle}"
                                      SelectionMode="Single"
                                      AutoGenerateColumns="False"
                                      CanUserSortColumns="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="False"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Включено" Width="70" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="OnGridEnabledClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="По центру" Width="70" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          IsChecked="{Binding Centered, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Click="OnGridCenteredClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Название столбца" Width="105" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Padding="4,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Ширина столбца" Width="92" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="OnGridWidthTextChanged"
                                                         BorderThickness="0" Background="Transparent"
                                                         VerticalContentAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Задать ширину" Width="88" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Выбрать" Margin="2,1" Padding="4,0"
                                                        Style="{StaticResource PluginButtonStyle}"
                                                        Click="OnGridPickWidthClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Вверх" Width="56" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Вверх" Margin="2,1" Padding="4,0"
                                                        Style="{StaticResource PluginButtonStyle}"
                                                        Click="OnGridMoveUpClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Вниз" Width="56" CanUserSort="False" CanUserReorder="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Вниз" Margin="2,1" Padding="4,0"
                                                        Style="{StaticResource PluginButtonStyle}"
                                                        Click="OnGridMoveDownClick" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="1" Text="Предпросмотр порядка (пропорционально ширине столбцов, высоте строк и текста)"
                                       VerticalAlignment="Bottom" Foreground="DimGray" />
                            <local:DirectoryPreviewControl x:Name="_directoryOrderPreview" Grid.Row="2" Margin="0,2,0,0" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            
        <TabItem Header="Масштабы">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#EFF7FF" Padding="12,7" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Область действия распознавания масштаба" FontWeight="Bold" Foreground="#1C4E79" Margin="0,0,0,4" />
                            <TextBlock Foreground="#374C5E" TextTrimming="CharacterEllipsis"
                                       Text="Блоки рамок: любой масштаб определяется по короткой стороне бумаги · Универсальный режим: только встроенные и пользовательские масштабы ниже" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56*" />
                            <ColumnDefinition Width="44*" />
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Распознаваемые масштабы универсального режима" Padding="8" Margin="0,0,5,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListBox x:Name="_scaleList" Grid.Row="0"
                                         SelectionMode="Extended"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         SelectionChanged="OnScaleListSelectionChanged" />
                                <TextBlock x:Name="_scaleListSummary" Grid.Row="1" Foreground="DimGray" Margin="0,4,0,0" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="1" Header="Пользовательский масштаб" Padding="10,8" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Ручной ввод" FontWeight="Bold" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="82" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="_scaleInput" Grid.Column="0" Margin="0,2,6,2"
                                             VerticalContentAlignment="Center"
                                             PreviewKeyDown="OnScaleInputKeyDown" />
                                    <Button x:Name="_addScaleButton" Grid.Column="1" Content="Добавить" MinWidth="72"
                                            Margin="0,2" Style="{StaticResource PluginButtonStyle}"
                                            Click="OnAddScaleClick" />
                                </Grid>
                                <TextBlock Foreground="DimGray" Margin="0,4,0,0"
                                           Text="Пример: 143 = 1:143&#x0a;0,25 = 4:1; также можно ввести 1:143 или 4:1" />
                                <TextBlock Text="Быстрые действия" FontWeight="Bold" Margin="0,8,0,4" />
                                <Button x:Name="_pickScaleButton" Content="Определить по чертежу…" MinWidth="150"
                                        HorizontalAlignment="Stretch" Margin="0,2"
                                        Style="{StaticResource PluginButtonStyle}"
                                        Click="OnPickScaleClick" />
                                <Button x:Name="_removeScaleButton" Content="Удалить выбранный масштаб" MinWidth="170"
                                        HorizontalAlignment="Stretch" Margin="0,2" IsEnabled="False"
                                        Style="{StaticResource PluginButtonStyle}"
                                        Click="OnRemoveScaleClick" />
                                <TextBlock x:Name="_scaleSelectionHint" Foreground="DimGray" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                <TextBlock Foreground="DimGray" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="При определении по чертежу укажите рамку и формат A0–A4; масштаб рассчитывается по короткой стороне. Изменения применятся после нажатия «Сохранить»." />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock x:Name="_footerHint" Grid.Row="1" VerticalAlignment="Center"
                   Foreground="DimGray" TextTrimming="CharacterEllipsis" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="По умолчанию" MinWidth="104" Margin="0,0,6,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnResetClick" />
            <Button Content="Отмена" MinWidth="82" Margin="0,0,6,0"
                    Style="{StaticResource PluginButtonStyle}" Click="OnCancelClick" />
            <Button Content="Сохранить" MinWidth="82"
                    Style="{StaticResource PluginButtonStyle}" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
