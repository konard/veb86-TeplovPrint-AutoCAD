<UserControl x:Class="ZwcadBatchPlot.ShortcutSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI" FontSize="11">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12,10,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,10"
                   Text="Задайте сокращённые команды для часто используемых функций. После сохранения введите сокращение в командной строке CAD. Пустое значение не создаёт сокращение. Используйте латинские буквы и цифры; первая — буква."/>

        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Исходная команда" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="Сокращение" FontWeight="SemiBold"/>
                </Grid>
                <StackPanel x:Name="RowsPanel"/>
            </StackPanel>
        </ScrollViewer>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="ОК" MinWidth="76" Style="{StaticResource PluginButtonStyle}"
                    Click="OnOkClick" Margin="0,0,4,0"/>
            <Button Content="Отмена" MinWidth="76" Style="{StaticResource PluginButtonStyle}"
                    Click="OnCancelClick"/>
        </StackPanel>
    </Grid>
</UserControl>
