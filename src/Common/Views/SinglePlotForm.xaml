<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZwcadBatchPlot.SinglePlotForm"
        Title="Печать одного листа"
        Width="660" Height="370"
        MinWidth="620" MinHeight="340"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" /> 
            <RowDefinition Height="32" /> 
            <RowDefinition Height="40" /> 
            <RowDefinition Height="40" /> 
            <RowDefinition Height="40" /> 
            <RowDefinition Height="32" /> 
            <RowDefinition Height="*" />  
            <RowDefinition Height="40" /> 
        </Grid.RowDefinitions>

        
        <TextBlock x:Name="_areaLabel" Grid.Row="0" VerticalAlignment="Center" />

        
        <TextBlock x:Name="_scaleLabel" Grid.Row="1" VerticalAlignment="Center" />

        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Лист:" VerticalAlignment="Center" />
            <ComboBox x:Name="_paperCombo" Grid.Column="1" Margin="0,5,0,5"
                      IsEditable="False" VerticalContentAlignment="Center" />
        </Grid>

        
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Путь вывода:" VerticalAlignment="Center" />
            <TextBox x:Name="_outputPath" Grid.Column="1" Margin="0,5,8,5" VerticalContentAlignment="Center" />
            <Button x:Name="_browseButton" Grid.Column="2" Content="Обзор..." MinWidth="96"
                    Margin="0,4,0,4" Style="{StaticResource PluginButtonStyle}" Click="BrowseButton_Click" />
        </Grid>

        
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Стиль печати:" VerticalAlignment="Center" />
            <ComboBox x:Name="_styleCombo" Grid.Column="1" Margin="0,5,8,5"
                      IsEditable="False" VerticalContentAlignment="Center" />
            <Button x:Name="_styleSettingsButton" Grid.Column="2" Content="Настроить" MinWidth="76"
                    Margin="0,4,0,4" Style="{StaticResource PluginButtonStyle}" Click="StyleSettingsButton_Click" />
        </Grid>

        
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <CheckBox x:Name="_leaveMargin" Content="Поля по краям, с каждой стороны короткой грани"
                      VerticalAlignment="Center" IsChecked="False"
                      Checked="LeaveMargin_CheckChanged" Unchecked="LeaveMargin_CheckChanged" />
            <ComboBox x:Name="_marginInput" Width="72" IsEnabled="False" Margin="4,0,0,0"
                      IsEditable="False" VerticalContentAlignment="Center" />
            <TextBlock Text="mm" Margin="3,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        

        
        <DockPanel Grid.Row="7" LastChildFill="False" Margin="0,5,0,0">
            <Button x:Name="_printButton" Content="Печать" MinWidth="96" DockPanel.Dock="Right"
                    IsDefault="True" Style="{StaticResource PluginButtonStyle}" Click="PrintButton_Click" />
            <Button x:Name="_previewButton" Content="Просмотр" MinWidth="96" DockPanel.Dock="Right"
                    Style="{StaticResource PluginButtonStyle}" Click="PreviewButton_Click" />
            <Button x:Name="_cancelButton" Content="Отмена" MinWidth="96" DockPanel.Dock="Right"
                    IsCancel="True" Style="{StaticResource PluginButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
