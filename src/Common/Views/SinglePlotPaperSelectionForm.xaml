<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ZwcadBatchPlot.SinglePlotPaperSelectionForm"
        Title="Выбор листа"
        Width="520" MinWidth="500" MinHeight="190"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="Для этой рамки доступны несколько форматов и масштабов.&#x0a;Выберите лист для текущей печати:" />

        <ComboBox x:Name="_choices" Grid.Row="1" IsEditable="False" MinHeight="22"
                  VerticalContentAlignment="Center" />

        
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
            <Button Content="ОК" MinWidth="82" DockPanel.Dock="Right"
                    IsDefault="True" Style="{StaticResource PluginButtonStyle}" Click="Ok_Click" />
            <Button Content="Отмена" MinWidth="82" DockPanel.Dock="Right"
                    IsCancel="True" Style="{StaticResource PluginButtonStyle}" />
        </DockPanel>
    </Grid>
</Window>
