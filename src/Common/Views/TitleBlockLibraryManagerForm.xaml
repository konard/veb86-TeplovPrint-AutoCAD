<Window x:Class="ZwcadBatchPlot.TitleBlockLibraryManagerForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZwcadBatchPlot"
        Title="Управление библиотекой рамок"
        Width="760" Height="360"
        MinWidth="700" MinHeight="320"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="11"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{x:Static SystemColors.ControlBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="WpfUi.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        
        <ScrollViewer DockPanel.Dock="Top"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="8,5,8,4">
                <Button Content="Добавить рамку" MinWidth="106" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnAddTitleBlockClick" />
                <Button x:Name="_saveButton" Content="Сохранить" MinWidth="96" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnSaveClick" />
                <Button Content="Удалить выбранное" MinWidth="126" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnDeleteClick" />
                <Button Content="Обновить" MinWidth="96" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnReloadClick" />
                <Button Content="Импорт библиотеки" MinWidth="136" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnImportClick" />
                <Button Content="Экспорт библиотеки" MinWidth="140" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnExportClick" />
                <Button Content="Открыть папку настроек" MinWidth="168" Margin="0,0,4,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnOpenFolderClick" />
                <Button Content="Закрыть" MinWidth="72" Margin="0,0,0,0"
                        Style="{StaticResource PluginButtonStyle}" Click="OnCloseClick" />
            </StackPanel>
        </ScrollViewer>

        
        <Border DockPanel.Dock="Bottom" Height="28">
            <TextBlock x:Name="_status" VerticalAlignment="Center" Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis" />
        </Border>

        
        <DataGrid x:Name="_grid"
                  Style="{StaticResource PluginGridStyle}"
                  Margin="0"
                  IsReadOnly="True"
                  Sorting="GridSorting"
                  LoadingRow="GridLoadingRow"
                  MouseDoubleClick="GridMouseDoubleClick"
                  ContextMenuOpening="GridContextMenuOpening"
                  PreviewMouseRightButtonDown="GridPreviewMouseRightButtonDown">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        
                        <DataTrigger Binding="{Binding PresentInDrawing}" Value="True">
                            <Setter Property="Background" Value="#FFE6E6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="_rowMenu">
                    <MenuItem Header="Изменить" Click="OnEditMenuItemClick" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</Window>
